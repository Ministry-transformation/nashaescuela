      *{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:90px}body{margin:0;color:var(--ink);background:var(--paper);font:15px/1.55 var(--sans);-webkit-font-smoothing:antialiased;background-image:radial-gradient(#816d4b12 .7px,transparent .8px),linear-gradient(90deg,#fff8 0,transparent 18%,#b59a6610 50%,transparent 83%,#fff5 100%);background-size:5px 5px,100% 100%}a{color:inherit}a:focus-visible,button:focus-visible{outline:3px solid #176cb5;outline-offset:4px}.wrap{width:min(var(--max),calc(100% - 96px));margin-inline:auto}.skip{position:absolute;z-index:20;left:1rem;top:-4rem;padding:.8rem 1rem;background:var(--white)}.skip:focus{top:1rem}.header{position:relative;z-index:10;border-bottom:1px solid var(--line);background:#f7f2e8ed;backdrop-filter:blur(12px)}.nav{height:84px;display:flex;align-items:center;justify-content:space-between;gap:28px}.wordmark{display:flex;align-items:center;gap:12px;min-width:295px;text-decoration:none}.compass{width:46px;height:46px;flex:none}.wordmark-copy{display:grid;gap:1px}.wordmark-copy strong{font:800 24px/1 var(--display);letter-spacing:.06em}.wordmark-copy small{font-size:9px;font-weight:700;letter-spacing:.34em}.nav-links{display:flex;align-items:center;gap:clamp(15px,2.2vw,34px)}.nav-links a{text-decoration:none;font-size:13px;font-weight:600;white-space:nowrap}.nav-links a:hover{text-decoration:underline;text-decoration-color:var(--red);text-underline-offset:6px}.nav-shop-nav{display:none}.nav-links .nav-main{position:relative}.nav-main:after{content:'⌄';padding-left:7px;color:var(--ink)}.nav-tools{display:flex;align-items:center;gap:12px}.nav-tool{display:grid;place-items:center;width:38px;height:38px;border:0;background:transparent;text-decoration:none}.nav-tool svg{width:22px;height:22px}.nav-shop{display:flex;gap:8px;width:auto;padding-inline:10px;font-size:12px;font-weight:700;white-space:nowrap}.language{border-left:1px solid var(--line);padding-left:18px;margin-left:4px;font-size:12px;font-weight: