      .footer{padding:31px 0 28px;gap:28px}.footer-links{gap:22px}.footer a{font-size:10px}.footer-note{font-size:8px;line-height:1.8}.footer-note .footer-credit a{color:var(--sea)}
      @media(max-width:900px){.wrap{width:calc(100% - 56px)}.site-header{height:78px}.hero{grid-template-columns:.9fr 1.1fr;gap:5%;padding:48px 0 60px}.hero-copy{padding-left:0}.hero h1{font-size:clamp(48px,6vw,64px)}.hero-visual{height:440px}.proof-inner{grid-template-columns:1.15fr repeat(3,1fr)}.proof-stat{padding-left:15px}.gallery{gap:27px 15px}.gallery-card h3{font-size:20px}}
      @media(max-width:650px){.wrap{width:calc(100% - 36px)}.site-header{height:72px}.brand-mark{width:33px;height:29px}.brand-name{font-size:19px}.head-contact{margin-left:auto;margin-right:10px}.head-contact .button{min-height:44px;padding:0 12px;font-size:10px}.head-contact .button span:first-child{display:none}.lang{padding-left:10px;margin-left:0;font-size:9px}.menu-toggle{display:block;flex:none;width:44px;height:44px;border-color:var(--line);font-size:20px}.nav{top:71px;left:-18px;right:-18px;background:var(--paper);box-shadow:0 16px 28px rgba(33,39,32,.08)}.nav a{padding:16px 5px;font-size:13px}.hero{display:flex;flex-direction:column;align-items:stretch;gap:25px;padding:41px 0 37px;min-height:0}.hero-copy{padding:0}.eyebrow{font-size:9px;margin-bottom:17px}.hero h1{font-size:clamp(46px,11.8vw,62px);max-width:520px;line-height:1.03}.hero-lead{font-size:13px;line-height:1.75;margin:18px 0 23px}.hero-actions{gap:19px}.hero-actions .button{min-height:48px;padding:0 16px}.hero-meta{margin-top:27px;gap:10px;flex-wrap:wrap}.hero-meta span{font-size:8px}.hero-meta span+span:before{margin-right:10px}.hero-visual{height:310px;width:100%;border-radius:0}.photo-note{right:8px;bottom:8px;padding:7px 8px;font-size:7px}.demo-notice{font-size:9px;padding-left:11px}.proof-inner{grid-template-columns:1fr 1fr;padding:24px 0;gap:0}.proof-intro{grid-column:1/-1;max-width:310px;font-size:18px;padding:0 0 15px}.proof-stat{padding:12px 6px 12px 12px}.proof-stat:nth-child(2){border-left:0;padding-left:0}.proof-stat b{font-size:8px}.proof-stat span{font-size:9px;line-height:1.5}.section{padding:76px 0}.section-head{display:block;margin-bottom:28px}.section-title{font-size:44px}.section-description{margin-top:14px;font-size:12px}.gallery{grid-template-columns:1fr 1fr;gap:25px 12px}.gallery-card:nth-child(1),.gallery-card:nth-child(4){grid-column:span 2}.gallery-image,.gallery-card:nth-child(1) .gallery-image,.gallery-card:nth-child(4) .gallery-image{aspect-ratio:1.45}.gallery-tag{top:8px;left:8px;padding:6px 7px;font-size:7px}.gallery-card h3{font-size:18px;margin:11px 0 4px}.gallery-card p{font-size:9px}.gallery-foot{display:block;margin-top:25px;padding-top:20px}.gallery-foot .button{margin-top:15px;width:100%}.approach{display:block}.approach-intro{margin-bottom:29px}.approach-intro .section-title{font-size:43px}.step{grid-template-columns:33px 1fr;gap:9px;padding:20px 0 23px}.step h3{font-size:20px}.step p{font-size:11px}.services-layout{display:block}.services-layout .section-title{font-size:43px;margin-bottom:27px}.service{font-size:19px;padding:17px 0}.contact{padding:66px 0}.contact-inner{grid-template-columns:1fr;gap:26px}.contact h2{font-size:49px}.contact p{font-size:12px}.contact-actions{flex-direction:row;align-items:center;flex-wrap:wrap}.contact .button{min-height:48px}.footer{display:grid;grid-template-columns:1fr;gap:17px;padding:25px 0}.footer-note{text-align:left;max-width:370px}.footer-links{gap:17px}}
      @media(max-width:370px){.wrap{width:calc(100% - 28px)}.hero h1{font-size:44px}.hero-visual{height:280px}.hero-meta span{font-size:7px}.gallery{gap:20px 9px}.gallery-card h3{font-size:16px}.contact h2{font-size:42px}.head-contact{gap:7px}.brand-name{font-size:17px}}
      /* Full-bleed home hero: the generated Mediterranean photo carries the opening screen. */
      .hero.wrap{position:relative;isolation:isolate;display:flex;align-items:center;width:100%;max-width:none;min-height:min(680px,calc(100svh - 82px));margin:0;padding:clamp(56px,6vw,88px) max(36px,calc((100% - var(--max))/2 + 24px)) 76px;overflow:hidden;background:var(--sea-deep);color:#fff}
      .hero-background{position:absolute;z-index:-2;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 53%;display:block}
      .hero.wrap:before{content:'';position:absolute;z-index:-1;inset:0;background:linear-gradient(90deg,rgba(18,27,23,.78) 0%,rgba(18,27,23,.59) 42%,rgba(18,27,23,.14) 100%),linear-gradient(0deg,rgba(18,27,23,.48) 0%,transparent 48%)}
      .hero-copy{position:relative;z-index:1;width:min(100%,650px);max-width:650px;padding:0;color:#fff}
      .hero .eyebrow{color:#e5d1a7}.hero h1{max-width:650px;color:#fff;font-size:clamp(52px,6.4vw,86px)}.hero h1 em{color:#e5d1a7}.hero-lead{max-width:460px;color:rgba(255,255,255,.9)}
      .hero .hero-actions .button{background:#e5d1a7;border-color:#e5d1a7;color:#24312a}.hero .hero-actions .button:hover{background:#f2e2c1;border-color:#f2e2c1;color:#24312a}.hero .text-link{color:#fff;border-color:#e5d1a7}.hero-meta{color:rgba(255,255,255,.82)}.hero-meta span+span:before{color:#e5d1a7}
      .hero .photo-note{right:max(20px,calc((100% - var(--max))/2));bottom:18px;z-index:1;background:rgba(18,27,23,.68);color:#fff;backdrop-filter:blur(8px)}
      .hero .image-mark{display:none}
      @media(max-width:900px){.hero.wrap{min-height:660px;padding-inline:28px}.hero .photo-note{right:20px}}
      @media(max-width:650px){.hero.wrap{justify-content:center;align-items:stretch;min-height:min(660px,calc(100svh - 230px));padding:36px 22px 62px}.hero-background{object-position:59% center}.hero.wrap:before{background:linear-gradient(90deg,rgba(18,27,23,.74) 0%,rgba(18,27,23,.52) 70%,rgba(18,27,23,.32) 100%),linear-gradient(0deg,rgba(18,27,23,.54) 0%,transparent 60%)}.hero-copy{width:100%;max-width:560px}.hero h1{font-size:clamp(47px,12vw,66px)}.hero-lead{max-width:430px}.hero .photo-note{right:14px;bottom:13px;padding:8px 10px;font-size:8px}}
      @media(max-width:370px){.hero.wrap{min-height:min(640px,calc(100svh - 210px));padding-inline:16px}.hero h1{font-size:44px}}
      @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*:before,*:after{transition:none!important;animation:none!important}}
    </style>
  </head>
  <body>
    <script src="https://mcp.figma.com/mcp/html-to-design/capture.js" async></script>
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <header class="wrap site-header">
      <a class="brand" href="#inicio" aria-label="VidaMar, inicio"><svg class="brand-mark" viewBox="0 0 42 34" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M2 17 13 7l11 10v14H2zM18 13 28 4l12 9v18H18"/><path d="M9 31v-8h7v8"/></svg><span class="brand-name">VidaMar<small>REAL ESTATE · SPAIN</small></span></a>
      <nav class="nav" id="site-nav" aria-label="Navegación principal"><a href={catalogUrl}>Viviendas</a><a href="#servicios">Servicios</a><a href="#proceso">Cómo te ayudamos</a><a href="#contacto">Contacto</a></nav>
      <div class="head-contact"><a class="button" href={`tel:${phone}`}><span>Llámanos</span><span class="arrow" aria-hidden="true">↗</span></a><span class="lang" aria-label="Idioma actual: español">ES</span></div>
      <button class="menu-toggle" id="menu-toggle" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="site-nav">☰</button>
    </header>
    <main id="contenido">
      <section class="wrap hero" id="inicio" aria-labelledby="hero-title">
        <div class="hero-copy"><p class="eyebrow">Asesoramiento inmobiliario · Torrevieja</p><h1 id="hero-title">Tu próximo capítulo, <em>junto al Mediterráneo.</em></h1><p class="hero-lead">Compra, venta y alquiler en la Costa Blanca. Cuéntanos qué buscas y te orientamos sobre las opciones actuales.</p><div class="hero-actions"><a class="button" href={catalogUrl}>Consultar opciones <span class="arrow" aria-hidden="true">↗</span></a><a class="text-link" href={`tel:${phone}`}>Hablar con VidaMar</a></div><div class="hero-meta"><span>Compra · venta</span><span>Alquiler</span><span>Costa Blanca</span></div></div>
        <img class="hero-background" src={`${imageBase}vidamar-home-hero.webp`} alt="" width="3072" height="1024" fetchpriority="high" aria-hidden="true"/><span class="photo-note">Imagen ilustrativa · no es un anuncio</span>
      </section>
      <div class="wrap demo-notice" role="note"><strong>Vista de demostración.</strong> Las imágenes de esta página son ilustrativas; el catálogo actual y la disponibilidad deben confirmarse con VidaMar.</div>
      <section class="proof-strip" aria-label="Ámbito de atención"><div class="wrap proof-inner"><div class="proof-intro">Una búsqueda más clara empieza con una conversación.</div><div class="proof-stat"><b>01 · ZONA</b><span>Torrevieja, Alicante</span></div><div class="proof-stat"><b>02 · OBJETIVO</b><span>Compra, venta o alquiler</span></div><div class="proof-stat"><b>03 · SIGUIENTE PASO</b><span>Consulta directa</span></div></div></section>
      <section class="section collection" id="viviendas" aria-labelledby="collection-title"><div class="wrap"><div class="section-head"><div><p class="eyebrow">Una primera mirada</p><h2 class="section-title" id="collection-title">Imagina tu vida <em>aquí.</em></h2></div><p class="section-description">Interiores luminosos, terrazas abiertas y rincones de la Costa Blanca. Estas imágenes ilustran el estilo de la zona, no viviendas anunciadas.</p></div>
        <div class="gallery" style={`--demo-image:url(${imageBase}vidamar-grid.webp)`}>{demos.map((item)=><article class="gallery-card"><div class="gallery-image" role="img" aria-label={item.note} style={`background-position:${item.pos}`}><span class="gallery-tag">Imagen ilustrativa</span></div><h3>{item.title}</h3><p>{item.type} · {item.place}</p></article>)}</div>
        <div class="gallery-foot"><p>¿Tienes en mente una zona, un tipo de vivienda o un presupuesto? Contacta directamente para consultar opciones disponibles y condiciones actuales.</p><a class="button" href={catalogUrl}>Ir al catálogo <span class="arrow" aria-hidden="true">↗</span></a></div>
      </div></section>
      <section class="section" id="proceso" aria-labelledby="process-title"><div class="wrap approach"><div class="approach-intro"><p class="eyebrow">Una conversación, paso a paso</p><h2 class="section-title" id="process-title">Encontrar vivienda empieza <em>por escucharte.</em></h2><p>El proceso concreto depende de lo que buscas y de las opciones disponibles. Empieza compartiendo tus preferencias y confirma cada detalle con el equipo.</p></div><div class="steps"><article class="step"><span class="step-no">01</span><div><h3>Cuéntanos qué necesitas</h3><p>Zona, tipo de vivienda y si buscas comprar, vender o alquilar. No hace falta tenerlo todo decidido.</p></div></article><article class="step"><span class="step-no">02</span><div><h3>Pregunta por las opciones</h3><p>Consulta qué viviendas encajan y pide información actualizada sobre cada anuncio y su disponibilidad.</p></div></article><article class="step"><span class="step-no">03</span><div><h3>Resuelve tus dudas</h3><p>Habla directamente con VidaMar sobre los siguientes pasos y los servicios que puedan ser relevantes para tu caso.</p></div></article></div></div></section>
      <section class="section service-band" id="servicios" aria-labelledby="services-title"><div class="wrap services-layout"><div><p class="eyebrow">Compra · venta · alquiler</p><h2 class="section-title" id="services-title">Apoyo inmobiliario en <em>cada decisión.</em></h2></div><div><div class="service-list"><div class="service"><span>Comprar una vivienda</span><small>Consulta directa</small></div><div class="service"><span>Vender una propiedad</span><small>Consulta directa</small></div><div class="service"><span>Buscar alquiler</span><small>Consulta directa</small></div><div class="service"><span>Gestión inmobiliaria</span><small>Por confirmar</small></div></div><p class="service-note">Los servicios y su alcance se describen de forma general a partir de los materiales disponibles. Confirma con VidaMar qué opciones ofrece actualmente y quién presta cada servicio.</p></div></div></section>
      <section class="contact" id="contacto" aria-labelledby="contact-title"><div class="wrap contact-inner"><div><p class="eyebrow">VidaMar · Torrevieja</p><h2 id="contact-title">¿Hablamos de <em>lo que buscas?</em></h2><p>Llama para consultar viviendas, disponibilidad y servicios actuales. El equipo podrá orientarte sobre la información que necesitas para empezar.</p></div><div class="contact-actions"><a class="button" href={`tel:${phone}`}>Llamar a VidaMar <span class="arrow" aria-hidden="true">↗</span></a><a class="contact-phone" href={`tel:${phone}`}>{phoneDisplay}</a></div></div></section>
    </main>
    <footer class="wrap footer"><a class="brand" href="#inicio"><svg class="brand-mark" viewBox="0 0 42 34" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M2 17 13 7l11 10v14H2zM18 13 28 4l12 9v18H18"/></svg><span class="brand-name">VidaMar<small>REAL ESTATE · SPAIN</small></span></a><div class="footer-links"><a href={catalogUrl}>Viviendas</a><a href="#servicios">Servicios</a><a href={`tel:${phone}`}>Llamar</a><a href="https://www.instagram.com/vidamar_spain/" target="_blank" rel="noopener noreferrer">Instagram ↗</a></div><div class="footer-note">Calle Ramón Gallud, 93 · Torrevieja, Alicante<br/>Dirección indicada en la tarjeta de visita; confirma antes de acudir.<span class="footer-credit">Sitio web desarrollado por <a href="https://ministry-transformation.github.io/" target="_blank" rel="noopener noreferrer">Ministerio de Transformación ↗</a></span></div></footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('#menu-toggle');
      const nav = document.querySelector<HTMLElement>('#site-nav');
      const closeMenu = () => { nav?.classList.remove('is-open'); toggle?.setAttribute('aria-expanded','false'); toggle?.setAttribute('aria-label','Abrir menú'); if(toggle)toggle.textContent='☰'; };
      toggle?.addEventListener('click',()=>{const open=toggle.getAttribute('aria-expanded')!=='true';toggle.setAttribute('aria-expanded',String(open));toggle.setAttribute('aria-label',open?'Cerrar menú':'Abrir menú');toggle.textContent=open?'×':'☰';nav?.classList.toggle('is-open',open);});
      nav?.querySelectorAll('a').forEach(link=>link.addEventListener('click',closeMenu));
      document.addEventListener('keydown',event=>{if(event.key==='Escape')closeMenu();});
    </script>
  </body>
</html>
