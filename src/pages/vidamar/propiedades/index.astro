---
const phone = '+34604145483';
const catalogImage = '/nashaescuela/images/vidamar-grid.webp';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f5f3ed" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content="Consulta a VidaMar sobre viviendas disponibles en Torrevieja. El catálogo de muestra no representa anuncios activos." />
    <title>Consulta de viviendas · VidaMar Torrevieja</title>
    <link rel="icon" type="image/svg+xml" href="/nashaescuela/vidamar/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;1,500&display=swap" rel="stylesheet" />
    <style>
      :root{font-family:'DM Sans',sans-serif;color:#1d2827;background:#f5f3ed;font-synthesis:none;text-rendering:optimizeLegibility;-webkit-font-smoothing:antialiased;--ink:#1d2827;--muted:#66716d;--paper:#f5f3ed;--white:#fffefa;--line:#d9ded7;--sea:#174c4a;--clay:#b76646;--serif:'Playfair Display',Georgia,serif;--mono:'DM Mono',monospace}*{box-sizing:border-box}body{margin:0;min-width:0}a{color:inherit}.wrap{width:min(1180px,calc(100% - 64px));margin-inline:auto}:focus-visible{outline:3px solid #b76646;outline-offset:4px;border-radius:3px}.skip{position:absolute;top:-60px;left:15px;background:white;padding:12px;z-index:9}.skip:focus{top:12px}.mono,.eyebrow{font:500 10px/1.4 var(--mono);letter-spacing:.12em;text-transform:uppercase}.header{height:82px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between}.brand{display:flex;gap:10px;align-items:center;text-decoration:none}.mark{width:37px;height:31px;color:var(--sea)}.brand-name{font:600 20px var(--serif)}.brand-name small{display:block;font:500 8px var(--mono);letter-spacing:.2em;color:var(--muted);margin-top:4px}.back{font-size:12px;text-decoration:none;border-bottom:1px solid var(--clay);padding:7px 0}.hero{padding:82px 0 45px}.eyebrow{color:var(--sea);display:flex;gap:10px;align-items:center}.eyebrow:before{content:'';width:20px;height:1px;background:currentColor}.hero h1{font:500 clamp(48px,7vw,80px)/1 var(--serif);letter-spacing:-.055em;margin:22px 0 17px;max-width:800px}.hero h1 em{color:var(--clay);font-weight:500}.lead{color:#52615c;font-size:14px;line-height:1.75;max-width:590px;margin:0}.notice{margin:0 auto 35px;padding:15px 18px;border-left:3px solid var(--clay);background:#efe5d7;color:#584b3d;font-size:11px;line-height:1.7}.search{padding:24px;background:#fffefa;border:1px solid var(--line);display:grid;grid-template-columns:1fr 1fr 1fr auto;gap:14px;align-items:end}.field label{display:block;font:500 9px var(--mono);letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin-bottom:8px}.field select{width:100%;height:48px;border:1px solid #bec9c2;background:#fffefa;color:var(--ink);padding:0 12px;border-radius:0;font-size:12px}.button{min-height:48px;padding:0 20px;background:var(--sea);color:white;border:1px solid var(--sea);display:inline-flex;align-items:center;justify-content:center;gap:14px;text-decoration:none;font-size:12px;font-weight:600;cursor:pointer}.button:hover{background:#113c3a}.button .arrow{font-size:17px}.results{margin-top:40px}.results-head{display:flex;justify-content:space-between;align-items:end;border-bottom:1px solid var(--line);padding-bottom:15px;margin-bottom:18px}.results-head h2{font:500 26px var(--serif);margin:0}.results-head span{font:400 9px var(--mono);letter-spacing:.08em;color:var(--muted)}.empty{padding:35px 28px;background:#e7e8de;display:grid;grid-template-columns:1fr auto;gap:24px;align-items:center}.empty h3{font:500 25px var(--serif);margin:0 0 7px}.empty p{font-size:11px;line-height:1.7;color:#59645f;margin:0;max-width:560px}.empty .button{white-space:nowrap}.inspiration{padding:78px 0 90px}.inspiration h2{font:500 clamp(36px,5vw,54px)/1.04 var(--serif);letter-spacing:-.04em;margin:0 0 13px}.inspiration h2 em{font-weight:500;color:var(--clay)}.inspiration>p{font-size:12px;color:var(--muted);line-height:1.7;max-width:610px;margin:0 0 25px}.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.tile{aspect-ratio:4/3;background-image:var(--catalog-image);background-size:200% 200%;background-repeat:no-repeat;position:relative}.tile:nth-child(1){background-position:0 0}.tile:nth-child(2){background-position:100% 0}.tile:nth-child(3){background-position:0 100%}.tile:nth-child(4){background-position:100% 100%}.tile span{position:absolute;top:10px;left:10px;background:rgba(255,254,250,.93);padding:7px 9px;font:400 8px var(--mono);letter-spacing:.06em;text-transform:uppercase}.footer{border-top:1px solid var(--line);padding:22px 0 30px;display:flex;justify-content:space-between;gap:20px;align-items:center}.footer a{font-size:10px;text-decoration:none}.foot-note{font:400 9px/1.6 var(--mono);color:var(--muted);text-align:right}
      @media(max-width:760px){.wrap{width:calc(100% - 36px)}.header{height:70px}.brand-name{font-size:18px}.hero{padding:54px 0 31px}.hero h1{font-size:clamp(47px,12vw,68px)}.search{grid-template-columns:1fr 1fr;padding:17px;gap:13px}.search .button{grid-column:1/-1;width:100%}.results{margin-top:28px}.results-head{align-items:start;gap:10px}.results-head h2{font-size:22px}.results-head span{max-width:130px;text-align:right;line-height:1.5}.empty{grid-template-columns:1fr;padding:25px 19px}.empty .button{width:100%}.inspiration{padding:62px 0}.grid{grid-template-columns:1fr 1fr;gap:11px}.footer{align-items:flex-start;flex-direction:column}.foot-note{text-align:left}}
      @media(max-width:370px){.wrap{width:calc(100% - 28px)}.search{grid-template-columns:1fr}.search .button{grid-column:auto}.hero h1{font-size:46px}.results-head{display:block}.results-head span{display:block;text-align:left;margin-top:9px}.inspiration{padding:52px 0}.tile span{font-size:7px;left:7px;top:7px;padding:5px 6px}}
      @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*:before,*:after{transition:none!important;animation:none!important}}
      :root{--ink:#262a24;--muted:#777568;--paper:#f6f3ed;--white:#fffefa;--line:#ded8cc;--sea:#354137;--sea-deep:#242d26;--clay:#a88c61;--serif:'Playfair Display',Georgia,serif;--mono:'DM Mono',monospace}
      body{background:var(--paper);color:var(--ink)}.wrap{width:min(1280px,calc(100% - 88px))}.header{height:88px;border-color:var(--line)}.brand-name{font-size:22px;letter-spacing:-.045em}.mark{color:var(--sea)}
      .back{font-size:11px;letter-spacing:.03em;border-color:var(--clay)}.hero{padding:85px 0 34px}.eyebrow{color:var(--clay);letter-spacing:.16em}.hero h1{font-size:clamp(54px,6vw,82px);letter-spacing:-.055em;line-height:1.02}.hero h1 em{color:var(--clay)}.lead{font-size:14px;line-height:1.8;color:#626257}
      .notice{margin-bottom:30px;padding:13px 16px;border-left:1px solid var(--clay);background:transparent;color:#69685e;font-size:10px;line-height:1.7}
      .search{padding:25px;background:var(--white);border:1px solid var(--line);gap:15px;box-shadow:0 14px 44px rgba(42,43,34,.035)}.field label{font-size:9px;color:var(--muted);letter-spacing:.14em}.field select{height:52px;border-color:var(--line);background:var(--white);font-size:12px}.button{min-height:52px;background:var(--sea);border-color:var(--sea);font-size:11px;letter-spacing:.04em}.button:hover{background:var(--sea-deep)}
      .results{margin-top:50px}.results-head{border-color:var(--line);padding-bottom:17px;margin-bottom:20px}.results-head h2{font-size:29px}.results-head span{color:var(--clay);font-size:8px;letter-spacing:.12em}.empty{padding:39px 32px;background:#efebe2;border-left:2px solid var(--clay)}.empty h3{font-size:27px}.empty p{font-size:12px;line-height:1.8;color:#626257}
      .inspiration{padding:90px 0 100px}.inspiration h2{font-size:clamp(40px,5vw,58px);letter-spacing:-.05em}.inspiration h2 em{color:var(--clay)}.inspiration>p{font-size:12px;line-height:1.8;color:var(--muted)}.grid{gap:16px}.tile{aspect-ratio:1.15}.tile span{top:12px;left:12px;padding:8px 10px;background:rgba(35,43,36,.76);color:#fff;font-size:8px;letter-spacing:.1em}
      .footer{border-color:var(--line);padding:25px 0 30px}.footer a{color:var(--sea);font-weight:600}.foot-note{font-size:8px;line-height:1.8}
      @media(max-width:760px){.wrap{width:calc(100% - 36px)}.header{height:72px}.brand-name{font-size:19px}.hero{padding:60px 0 28px}.hero h1{font-size:clamp(47px,11.8vw,66px)}.search{padding:18px;gap:13px}.search .button{min-height:48px}.results{margin-top:37px}.results-head h2{font-size:24px}.empty{padding:28px 21px}.empty h3{font-size:23px}.inspiration{padding:70px 0}.grid{gap:12px}.tile{aspect-ratio:1.05}.tile span{font-size:7px;top:8px;left:8px;padding:6px 7px}.footer{align-items:flex-start;flex-direction:column;gap:9px}}
      @media(max-width:370px){.wrap{width:calc(100% - 28px)}.search{grid-template-columns:1fr}.search .button{grid-column:auto}.hero h1{font-size:44px}.results-head{display:block}.results-head span{display:block;text-align:left;margin-top:9px}}
    </style>
  </head>
  <body>
    <a class="skip" href="#main">Saltar al contenido</a>
    <header class="wrap header"><a class="brand" href="/nashaescuela/vidamar/" aria-label="VidaMar, inicio"><svg class="mark" viewBox="0 0 42 34" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M2 17 13 7l11 10v14H2zM18 13 28 4l12 9v18H18"/><path d="M9 31v-8h7v8"/></svg><span class="brand-name">VidaMar<small>REAL ESTATE · SPAIN</small></span></a><a class="back" href="/nashaescuela/vidamar/">Volver al inicio ↗</a></header>
    <main id="main" class="wrap">
      <section class="hero"><p class="eyebrow">Vivienda · Torrevieja</p><h1>Encuentra un lugar <em>para ti.</em></h1><p class="lead">Cuéntanos si buscas comprar o alquilar y qué tipo de vivienda tienes en mente. El equipo puede informarte sobre las opciones actuales.</p></section>
      <p class="notice"><strong>Catálogo de demostración.</strong> El inventario en tiempo real de VidaMar todavía no está conectado a esta vista. No se muestran anuncios, precios ni disponibilidad inventados.</p>
      <form class="search" id="interest-form"><div class="field"><label for="operation">¿Qué necesitas?</label><select id="operation" name="operation"><option value="Comprar">Comprar</option><option value="Alquilar">Alquilar</option><option value="Vender">Vender</option></select></div><div class="field"><label for="kind">Tipo de vivienda</label><select id="kind" name="kind"><option value="Cualquier tipo">Cualquier tipo</option><option value="Apartamento">Apartamento</option><option value="Casa">Casa</option><option value="Vivienda con terraza">Vivienda con terraza</option></select></div><div class="field"><label for="area">Zona de interés</label><select id="area" name="area"><option value="Torrevieja">Torrevieja</option><option value="Costa Blanca">Costa Blanca</option></select></div><button class="button" type="submit">Consultar opciones <span class="arrow" aria-hidden="true">↗</span></button></form>
      <section class="results" aria-live="polite" aria-labelledby="results-title"><div class="results-head"><h2 id="results-title">Opciones disponibles</h2><span id="results-label">CATÁLOGO EN TIEMPO REAL · NO CONECTADO</span></div><div class="empty" id="empty-state"><div><h3>Confirma la oferta directamente con VidaMar.</h3><p>Las propiedades y su disponibilidad cambian. Llama al equipo para contarle tus preferencias y solicitar información actualizada.</p></div><a class="button" href={`tel:${phone}`}>Llamar a VidaMar <span class="arrow" aria-hidden="true">↗</span></a></div></section>
      <section class="inspiration"><h2>Un poco de inspiración <em>mediterránea.</em></h2><p>Estas fotografías generadas para el diseño muestran ejemplos de interiores y espacios de la zona. No son fichas de propiedades ni representan viviendas en venta o alquiler.</p><div class="grid" style={`--catalog-image:url(${catalogImage})`}><div class="tile" role="img" aria-label="Interior mediterráneo ilustrativo"><span>Imagen ilustrativa</span></div><div class="tile" role="img" aria-label="Terraza costera ilustrativa"><span>Imagen ilustrativa</span></div><div class="tile" role="img" aria-label="Cocina mediterránea ilustrativa"><span>Imagen ilustrativa</span></div><div class="tile" role="img" aria-label="Calle de Torrevieja ilustrativa"><span>Imagen ilustrativa</span></div></div></section>
    </main>
    <footer class="wrap footer"><a href={`tel:${phone}`}>+34 604 14 54 83 · Llamar</a><span class="foot-note">La disponibilidad actual debe confirmarse con VidaMar.<br/><span>Sitio web desarrollado por <a href="https://ministry-transformation.github.io/" target="_blank" rel="noopener noreferrer">Ministerio de Transformación ↗</a></span></span></footer>
    <script>
      const form=document.querySelector<HTMLFormElement>('#interest-form');
      const label=document.querySelector<HTMLElement>('#results-label');
      const empty=document.querySelector<HTMLElement>('#empty-state');
      form?.addEventListener('submit',(event)=>{event.preventDefault();const data=new FormData(form);const parts=[data.get('operation'),data.get('kind'),data.get('area')].filter(Boolean).join(' · ');if(label)label.textContent=`CONSULTA: ${String(parts).toLocaleUpperCase('es')}`;empty?.scrollIntoView({behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth',block:'center'});});
    </script>
  </body>
</html>
